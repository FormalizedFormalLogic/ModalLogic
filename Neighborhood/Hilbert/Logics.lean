abbrev LogicE5 : Logic α := Hilbert { Axioms.Five A | (A) }
instance : (@LogicE5 α).HasAxiomFive := Hilbert.hasAxiomFive_of $ by grind;

abbrev LogicET5 : Logic α := Hilbert $
  { Axioms.T A | (A) } ∪
