module

public import Neighborhood.Hilbert.Basic

/-!
# The classical non-normal modal logics between `LogicE` and `LogicET5`

Definitions of the logics `LogicE`, `LogicEM`, ..., `LogicET5` by their Hilbert
axiomatisations, each given as the `Hilbert` system generated by every instance of the named
axiom schemes, and the two coincidences of logics with different axiom sets.
-/

@[expose] public section

variable {α : Type u}

/-! ### The weakest logic -/

/-- The weakest classical modal logic, i.e. the Hilbert system with no additional axiom scheme. -/
abbrev LogicE : Logic α := Hilbert ∅

/-! ### Logics generated by a single axiom scheme -/

/-- Every instance of the axiom scheme `M`. -/
abbrev LogicEM.axioms : FormulaSet α := { Axioms.M A B | (A) (B) }

/-- The logic generated by the axiom scheme `M`. -/
abbrev LogicEM : Logic α := Hilbert LogicEM.axioms

instance : (LogicEM (α := α)).HasAxiomM := Hilbert.hasAxiomM_of fun A B => ⟨A, B, rfl⟩

/-- Every instance of the axiom scheme `C`. -/
abbrev LogicEC.axioms : FormulaSet α := { Axioms.C A B | (A) (B) }

/-- The logic generated by the axiom scheme `C`. -/
abbrev LogicEC : Logic α := Hilbert LogicEC.axioms

instance : (LogicEC (α := α)).HasAxiomC := Hilbert.hasAxiomC_of fun A B => ⟨A, B, rfl⟩

/-- The axiom `N`. -/
abbrev LogicEN.axioms : FormulaSet α := {Axioms.N}

/-- The logic generated by the axiom `N`. -/
abbrev LogicEN : Logic α := Hilbert LogicEN.axioms

instance : (LogicEN (α := α)).HasAxiomN := Hilbert.hasAxiomN_of rfl

/-! ### Logics combining `M`, `C`, `N` -/

/-- Every instance of the axiom schemes `M` and `C`. -/
abbrev LogicEMC.axioms : FormulaSet α := LogicEM.axioms ∪ LogicEC.axioms

/-- The logic generated by the axiom schemes `M` and `C`. -/
abbrev LogicEMC : Logic α := Hilbert LogicEMC.axioms

instance : (LogicEMC (α := α)).HasAxiomM := Hilbert.hasAxiomM_of fun A B => Or.inl ⟨A, B, rfl⟩
instance : (LogicEMC (α := α)).HasAxiomC := Hilbert.hasAxiomC_of fun A B => Or.inr ⟨A, B, rfl⟩

/-- Every instance of the axiom scheme `M` together with the axiom `N`. -/
abbrev LogicEMN.axioms : FormulaSet α := LogicEM.axioms ∪ LogicEN.axioms

/-- The logic generated by the axiom scheme `M` together with the axiom `N`. -/
abbrev LogicEMN : Logic α := Hilbert LogicEMN.axioms

instance : (LogicEMN (α := α)).HasAxiomM := Hilbert.hasAxiomM_of fun A B => Or.inl ⟨A, B, rfl⟩
instance : (LogicEMN (α := α)).HasAxiomN := Hilbert.hasAxiomN_of (Or.inr rfl)

/-- Every instance of the axiom scheme `C` together with the axiom `N`. -/
abbrev LogicECN.axioms : FormulaSet α := LogicEC.axioms ∪ LogicEN.axioms

/-- The logic generated by the axiom scheme `C` together with the axiom `N`. -/
abbrev LogicECN : Logic α := Hilbert LogicECN.axioms

instance : (LogicECN (α := α)).HasAxiomC := Hilbert.hasAxiomC_of fun A B => Or.inl ⟨A, B, rfl⟩
instance : (LogicECN (α := α)).HasAxiomN := Hilbert.hasAxiomN_of (Or.inr rfl)

/-- Every instance of the axiom schemes `M`, `C` together with the axiom `N`. -/
abbrev LogicEMCN.axioms : FormulaSet α := LogicEM.axioms ∪ LogicEC.axioms ∪ LogicEN.axioms

/-- The logic generated by the axiom schemes `M`, `C` together with the axiom `N`. -/
abbrev LogicEMCN : Logic α := Hilbert LogicEMCN.axioms

instance : (LogicEMCN (α := α)).HasAxiomM := Hilbert.hasAxiomM_of fun A B => by grind;
instance : (LogicEMCN (α := α)).HasAxiomC :=
  Hilbert.hasAxiomC_of fun A B => Or.inl (Or.inr ⟨A, B, rfl⟩)
instance : (LogicEMCN (α := α)).HasAxiomN := Hilbert.hasAxiomN_of (Or.inr rfl)

/-! ### Logics combining `M`, `C`, `K` -/

/-- Every instance of the axiom scheme `K`. -/
abbrev LogicEK.axioms : FormulaSet α := { Axioms.K A B | (A) (B) }

/-- The logic generated by the axiom scheme `K`. -/
abbrev LogicEK : Logic α := Hilbert LogicEK.axioms

instance : (LogicEK (α := α)).HasAxiomK := Hilbert.hasAxiomK_of fun A B => ⟨A, B, rfl⟩

/-- Every instance of the axiom schemes `M` and `K`. -/
abbrev LogicEMK.axioms : FormulaSet α := LogicEM.axioms ∪ LogicEK.axioms

/-- The logic generated by the axiom schemes `M` and `K`. -/
abbrev LogicEMK : Logic α := Hilbert LogicEMK.axioms

instance : (LogicEMK (α := α)).HasAxiomM := Hilbert.hasAxiomM_of fun A B => Or.inl ⟨A, B, rfl⟩
instance : (LogicEMK (α := α)).HasAxiomK := Hilbert.hasAxiomK_of fun A B => Or.inr ⟨A, B, rfl⟩

/-- Every instance of the axiom schemes `M`, `C` and `K`. -/
abbrev LogicEMCK.axioms : FormulaSet α := LogicEM.axioms ∪ LogicEC.axioms ∪ LogicEK.axioms

/-- The logic generated by the axiom schemes `M`, `C` and `K`. -/
abbrev LogicEMCK : Logic α := Hilbert LogicEMCK.axioms

instance : (LogicEMCK (α := α)).HasAxiomM :=
  Hilbert.hasAxiomM_of fun A B => Or.inl (Or.inl ⟨A, B, rfl⟩)
instance : (LogicEMCK (α := α)).HasAxiomC :=
  Hilbert.hasAxiomC_of fun A B => Or.inl (Or.inr ⟨A, B, rfl⟩)
instance : (LogicEMCK (α := α)).HasAxiomK := Hilbert.hasAxiomK_of fun A B => Or.inr ⟨A, B, rfl⟩

/-! ### Logics with the reflexivity axiom `T` -/

/-- Every instance of the axiom scheme `T`. -/
abbrev LogicET.axioms : FormulaSet α := { Axioms.T A | (A) }

/-- The logic generated by the axiom scheme `T`. -/
abbrev LogicET : Logic α := Hilbert LogicET.axioms

instance : (LogicET (α := α)).HasAxiomT := Hilbert.hasAxiomT_of fun A => ⟨A, rfl⟩

/-- Every instance of the axiom schemes `M` and `T`. -/
abbrev LogicEMT.axioms : FormulaSet α := LogicEM.axioms ∪ LogicET.axioms

/-- The logic generated by the axiom schemes `M` and `T`. -/
abbrev LogicEMT : Logic α := Hilbert LogicEMT.axioms

instance : (LogicEMT (α := α)).HasAxiomM := Hilbert.hasAxiomM_of fun A B => Or.inl ⟨A, B, rfl⟩
instance : (LogicEMT (α := α)).HasAxiomT := Hilbert.hasAxiomT_of fun A => Or.inr ⟨A, rfl⟩

/-! ### Logics with the seriality axiom `D` -/

/-- Every instance of the axiom scheme `D`. -/
abbrev LogicED.axioms : FormulaSet α := { Axioms.D A | (A) }

/-- The logic generated by the axiom scheme `D`. -/
abbrev LogicED : Logic α := Hilbert LogicED.axioms

instance : (LogicED (α := α)).HasAxiomD := Hilbert.hasAxiomD_of fun A => ⟨A, rfl⟩

/-- Every instance of the axiom `N` together with the axiom scheme `D`. -/
abbrev LogicEND.axioms : FormulaSet α := LogicEN.axioms ∪ LogicED.axioms

/-- The logic generated by the axiom `N` together with the axiom scheme `D`. -/
abbrev LogicEND : Logic α := Hilbert LogicEND.axioms

instance : (LogicEND (α := α)).HasAxiomN := Hilbert.hasAxiomN_of (Or.inl rfl)
instance : (LogicEND (α := α)).HasAxiomD := Hilbert.hasAxiomD_of fun A => Or.inr ⟨A, rfl⟩

/-! ### The alternative seriality axiom `P` -/

/-- The axiom `P`. -/
abbrev LogicEP.axioms : FormulaSet α := {Axioms.P}

/-- The logic generated by the axiom `P`. -/
abbrev LogicEP : Logic α := Hilbert LogicEP.axioms

instance : (LogicEP (α := α)).HasAxiomP := Hilbert.hasAxiomP_of rfl

/-! ### Logics with the symmetry axiom `B` -/

/-- Every instance of the axiom scheme `B`. -/
abbrev LogicEB.axioms : FormulaSet α := { Axioms.B A | (A) }

/-- The logic generated by the axiom scheme `B`. -/
abbrev LogicEB : Logic α := Hilbert LogicEB.axioms

instance : (LogicEB (α := α)).HasAxiomB := Hilbert.hasAxiomB_of fun A => ⟨A, rfl⟩

/-- Every instance of the axiom schemes `T` and `B`. -/
abbrev LogicETB.axioms : FormulaSet α := LogicET.axioms ∪ LogicEB.axioms

/-- The logic generated by the axiom schemes `T` and `B`. -/
abbrev LogicETB : Logic α := Hilbert LogicETB.axioms

instance : (LogicETB (α := α)).HasAxiomT := Hilbert.hasAxiomT_of fun A => Or.inl ⟨A, rfl⟩
instance : (LogicETB (α := α)).HasAxiomB := Hilbert.hasAxiomB_of fun A => Or.inr ⟨A, rfl⟩

/-- Every instance of the axiom `N` together with the axiom schemes `T` and `B`. -/
abbrev LogicENTB.axioms : FormulaSet α := LogicEN.axioms ∪ LogicET.axioms ∪ LogicEB.axioms

/-- The logic generated by the axiom `N` together with the axiom schemes `T` and `B`. -/
abbrev LogicENTB : Logic α := Hilbert LogicENTB.axioms

instance : (LogicENTB (α := α)).HasAxiomN := Hilbert.hasAxiomN_of (Or.inl (Or.inl rfl))
instance : (LogicENTB (α := α)).HasAxiomT := Hilbert.hasAxiomT_of fun A => Or.inl (Or.inr ⟨A, rfl⟩)
instance : (LogicENTB (α := α)).HasAxiomB := Hilbert.hasAxiomB_of fun A => Or.inr ⟨A, rfl⟩

/-! ### Logics with the transitivity axiom `Four` -/

/-- Every instance of the axiom scheme `Four`. -/
abbrev LogicE4.axioms : FormulaSet α := { Axioms.Four A | (A) }

/-- The logic generated by the axiom scheme `Four`. -/
abbrev LogicE4 : Logic α := Hilbert LogicE4.axioms

instance : (LogicE4 (α := α)).HasAxiomFour := Hilbert.hasAxiomFour_of fun A => ⟨A, rfl⟩

/-- Every instance of the axiom `N` together with the axiom scheme `Four`. -/
abbrev LogicEN4.axioms : FormulaSet α := LogicEN.axioms ∪ LogicE4.axioms

/-- The logic generated by the axiom `N` together with the axiom scheme `Four`. -/
abbrev LogicEN4 : Logic α := Hilbert LogicEN4.axioms

instance : (LogicEN4 (α := α)).HasAxiomN := Hilbert.hasAxiomN_of (Or.inl rfl)
instance : (LogicEN4 (α := α)).HasAxiomFour := Hilbert.hasAxiomFour_of fun A => Or.inr ⟨A, rfl⟩

/-- Every instance of the axiom schemes `T` and `Four`. -/
abbrev LogicET4.axioms : FormulaSet α := LogicET.axioms ∪ LogicE4.axioms

/-- The logic generated by the axiom schemes `T` and `Four`. -/
abbrev LogicET4 : Logic α := Hilbert LogicET4.axioms

instance : (LogicET4 (α := α)).HasAxiomT := Hilbert.hasAxiomT_of fun A => Or.inl ⟨A, rfl⟩
instance : (LogicET4 (α := α)).HasAxiomFour := Hilbert.hasAxiomFour_of fun A => Or.inr ⟨A, rfl⟩

/-- Every instance of the axiom `N` together with the axiom schemes `T` and `Four`. -/
abbrev LogicENT4.axioms : FormulaSet α := LogicEN.axioms ∪ LogicET.axioms ∪ LogicE4.axioms

/-- The logic generated by the axiom `N` together with the axiom schemes `T` and `Four`. -/
abbrev LogicENT4 : Logic α := Hilbert LogicENT4.axioms

instance : (LogicENT4 (α := α)).HasAxiomN := Hilbert.hasAxiomN_of (Or.inl (Or.inl rfl))
instance : (LogicENT4 (α := α)).HasAxiomT := Hilbert.hasAxiomT_of fun A => Or.inl (Or.inr ⟨A, rfl⟩)
instance : (LogicENT4 (α := α)).HasAxiomFour := Hilbert.hasAxiomFour_of fun A => Or.inr ⟨A, rfl⟩

/-- Every instance of the axiom `N` together with the axiom schemes `D` and `Four`. -/
abbrev LogicEND4.axioms : FormulaSet α := LogicEN.axioms ∪ LogicED.axioms ∪ LogicE4.axioms

/-- The logic generated by the axiom `N` together with the axiom schemes `D` and `Four`. -/
abbrev LogicEND4 : Logic α := Hilbert LogicEND4.axioms

instance : (LogicEND4 (α := α)).HasAxiomN := Hilbert.hasAxiomN_of (Or.inl (Or.inl rfl))
instance : (LogicEND4 (α := α)).HasAxiomD := Hilbert.hasAxiomD_of fun A => Or.inl (Or.inr ⟨A, rfl⟩)
instance : (LogicEND4 (α := α)).HasAxiomFour := Hilbert.hasAxiomFour_of fun A => Or.inr ⟨A, rfl⟩

/-- Every instance of the axiom schemes `M`, `T` and `Four`. -/
abbrev LogicEMT4.axioms : FormulaSet α := LogicEM.axioms ∪ LogicET.axioms ∪ LogicE4.axioms

/-- The logic generated by the axiom schemes `M`, `T` and `Four`. -/
abbrev LogicEMT4 : Logic α := Hilbert LogicEMT4.axioms

instance : (LogicEMT4 (α := α)).HasAxiomM :=
  Hilbert.hasAxiomM_of fun A B => Or.inl (Or.inl ⟨A, B, rfl⟩)
instance : (LogicEMT4 (α := α)).HasAxiomT := Hilbert.hasAxiomT_of fun A => Or.inl (Or.inr ⟨A, rfl⟩)
instance : (LogicEMT4 (α := α)).HasAxiomFour := Hilbert.hasAxiomFour_of fun A => Or.inr ⟨A, rfl⟩

/-- Every instance of the axiom scheme `M`, the axiom `N` together with the axiom
schemes `T` and `Four`. -/
abbrev LogicEMNT4.axioms : FormulaSet α :=
  LogicEM.axioms ∪ LogicEN.axioms ∪ LogicET.axioms ∪ LogicE4.axioms

/-- The logic generated by the axiom scheme `M`, the axiom `N` together with the axiom schemes `T`
and `Four`. -/
abbrev LogicEMNT4 : Logic α := Hilbert LogicEMNT4.axioms

instance : (LogicEMNT4 (α := α)).HasAxiomM :=
  Hilbert.hasAxiomM_of fun A B => Or.inl (Or.inl (Or.inl ⟨A, B, rfl⟩))
instance : (LogicEMNT4 (α := α)).HasAxiomN := Hilbert.hasAxiomN_of (Or.inl (Or.inl (Or.inr rfl)))
instance : (LogicEMNT4 (α := α)).HasAxiomT :=
  Hilbert.hasAxiomT_of fun A => Or.inl (Or.inr ⟨A, rfl⟩)
instance : (LogicEMNT4 (α := α)).HasAxiomFour := Hilbert.hasAxiomFour_of fun A => Or.inr ⟨A, rfl⟩

/-- Every instance of the axiom schemes `M`, `C` and `Four`. -/
abbrev LogicEMC4.axioms : FormulaSet α := LogicEM.axioms ∪ LogicEC.axioms ∪ LogicE4.axioms

/-- The logic generated by the axiom schemes `M`, `C` and `Four`. -/
abbrev LogicEMC4 : Logic α := Hilbert LogicEMC4.axioms

instance : (LogicEMC4 (α := α)).HasAxiomM :=
  Hilbert.hasAxiomM_of fun A B => Or.inl (Or.inl ⟨A, B, rfl⟩)
instance : (LogicEMC4 (α := α)).HasAxiomC :=
  Hilbert.hasAxiomC_of fun A B => Or.inl (Or.inr ⟨A, B, rfl⟩)
instance : (LogicEMC4 (α := α)).HasAxiomFour := Hilbert.hasAxiomFour_of fun A => Or.inr ⟨A, rfl⟩

/-- Every instance of the axiom schemes `M`, `C`, the axiom `N` together with the
axiom scheme `Four`. -/
abbrev LogicEMCN4.axioms : FormulaSet α :=
  LogicEM.axioms ∪ LogicEC.axioms ∪ LogicEN.axioms ∪ LogicE4.axioms

/-- The logic generated by the axiom schemes `M`, `C`, the axiom `N` together with the axiom
scheme `Four`. -/
abbrev LogicEMCN4 : Logic α := Hilbert LogicEMCN4.axioms

instance : (LogicEMCN4 (α := α)).HasAxiomM :=
  Hilbert.hasAxiomM_of fun A B => Or.inl (Or.inl (Or.inl ⟨A, B, rfl⟩))
instance : (LogicEMCN4 (α := α)).HasAxiomC :=
  Hilbert.hasAxiomC_of fun A B => Or.inl (Or.inl (Or.inr ⟨A, B, rfl⟩))
instance : (LogicEMCN4 (α := α)).HasAxiomN := Hilbert.hasAxiomN_of (Or.inl (Or.inr rfl))
instance : (LogicEMCN4 (α := α)).HasAxiomFour := Hilbert.hasAxiomFour_of fun A => Or.inr ⟨A, rfl⟩

/-! ### Logics with the euclideanness axiom `Five` -/

/-- Every instance of the axiom scheme `Five`. -/
abbrev LogicE5.axioms : FormulaSet α := { Axioms.Five A | (A) }

/-- The logic generated by the axiom scheme `Five`. -/
abbrev LogicE5 : Logic α := Hilbert LogicE5.axioms

instance : (LogicE5 (α := α)).HasAxiomFive := Hilbert.hasAxiomFive_of fun A => ⟨A, rfl⟩

/-- Every instance of the axiom schemes `T` and `Five`. -/
abbrev LogicET5.axioms : FormulaSet α := LogicET.axioms ∪ LogicE5.axioms

/-- The logic generated by the axiom schemes `T` and `Five`. -/
abbrev LogicET5 : Logic α := Hilbert LogicET5.axioms

instance : (LogicET5 (α := α)).HasAxiomT := Hilbert.hasAxiomT_of fun A => Or.inl ⟨A, rfl⟩
instance : (LogicET5 (α := α)).HasAxiomFive := Hilbert.hasAxiomFive_of fun A => Or.inr ⟨A, rfl⟩

/-! ### Coincidences -/

/-- The axiom scheme `C` is redundant over `M` and `K`. -/
theorem LogicEMK_eq_LogicEMCK : (LogicEMK (α := α)) = LogicEMCK := by
  apply Set.Subset.antisymm
  · apply Hilbert.subset_of_subset_axioms
    rintro A (hM | hK)
    · exact Or.inl (Or.inl hM)
    · exact Or.inr hK
  · apply Hilbert.subset_of_provable_axioms
    rintro A ((⟨B, C, rfl⟩ | ⟨B, C, rfl⟩) | ⟨B, C, rfl⟩) <;>
      first | exact Logic.axiomM | exact Logic.axiomC | exact Logic.axiomK

/-- The axiom `N` is redundant over `T` and `B`. -/
theorem LogicETB_eq_LogicENTB : (LogicETB (α := α)) = LogicENTB := by
  apply Set.Subset.antisymm
  · apply Hilbert.subset_of_subset_axioms
    rintro A (hT | hB)
    · exact Or.inl (Or.inr hT)
    · exact Or.inr hB
  · apply Hilbert.subset_of_provable_axioms
    rintro A ((rfl | ⟨B, rfl⟩) | ⟨B, rfl⟩) <;>
      first | exact Logic.axiomN | exact Logic.axiomT | exact Logic.axiomB

end
