abbrev LogicEP : Logic α := Hilbert { Axioms.P }
instance : (@LogicEP α).HasAxiomP := Hilbert.hasAxiomP_of rfl

abbrev LogicEB : Logic α := Hilbert { Axioms.B A | (A) }
