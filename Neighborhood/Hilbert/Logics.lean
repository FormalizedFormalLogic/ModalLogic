instance : (@LogicEMK α).HasAxiomM := Hilbert.hasAxiomM_of $ by grind;
instance : (@LogicEMK α).HasAxiomK := Hilbert.hasAxiomK_of $ by grind;

abbrev LogicEMCK : Logic α := Hilbert $
  { Axioms.M A B | (A) (B) } ∪
  { Axioms.C A B | (A) (B) } ∪
